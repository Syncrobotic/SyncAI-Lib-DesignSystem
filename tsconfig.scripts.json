{
  // The CI scripts (scripts/*.mjs and *.cjs) are plain JavaScript run by Node, so the type checker reads their JSDoc
  // types instead: a script that guards the registry should not itself break on a renamed field or a missing null check.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "incremental": false
  },
  "include": ["scripts/*.mjs", "scripts/*.cjs"],
  "exclude": ["node_modules"]
}
