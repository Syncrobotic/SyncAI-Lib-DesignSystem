  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "shadcn build -o public/r && next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "registry:build": "shadcn build -o public/r",
