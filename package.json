{
  "name": "@syncrobotic/design-system",
  "version": "0.46.0",
  "private": true,
  "description": "A robotics UI kit for React: emergency stop, teleoperation, robot map, camera feed, LiDAR point cloud, URDF robot model and alarms, with design tokens and ready-made screens, shipped as a shadcn/ui registry for Tailwind CSS v4.",
  "keywords": [
    "robotics",
    "robotics-ui-kit",
    "robot-ui",
    "robot-dashboard",
    "ros",
    "ros2",
    "teleoperation",
    "lidar",
    "point-cloud",
    "urdf",
    "occupancy-grid",
    "fleet-management",
    "design-system",
    "ui-kit",
    "shadcn",
    "shadcn-registry",
    "shadcn-ui",
    "tailwindcss",
    "tailwindcss-v4",
    "react",
    "nextjs",
    "design-tokens",
    "blocks",
    "dashboard",
    "charts",
    "mcp",
    "llms-txt",
    "emergency-stop",
    "dark-mode",
    "high-contrast",
    "accessibility",
    "wcag",
    "data-visualization",
    "colorblind-safe"
  ],
  "homepage": "https://design-system.syncrobotic.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syncrobotic/SyncAI-Lib-DesignSystem.git"
  },
  "bugs": {
    "url": "https://github.com/Syncrobotic/SyncAI-Lib-DesignSystem/issues"
  },
  "author": "SYNCROBOTIC",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "shadcn build -o public/r && cp registry/kit-tags.json public/r/kit-tags.json && next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "registry:build": "shadcn build -o public/r && cp registry/kit-tags.json public/r/kit-tags.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.registry.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "test:stories": "playwright test tests/stories.spec.ts",
    "ci": "npm run lint:tokens && npm run lint:registry && npm run lint:rules && npm run lint:numbers && npm run lint:motion && npm run lint:versions && npm run lint:dtcg && npm run lint:props && npm run lint:a11y && npm run lint:thumbs && npm run lint && npm run typecheck && npm test && npm run build && npm run lint:html-size && npm run build-storybook",
    "test": "vitest run",
    "lint:registry": "node scripts/check-registry.mjs",
    "lint:rules": "node scripts/check-rules.mjs",
    "lint:props": "node scripts/props.mjs",
    "lint:numbers": "node scripts/check-numbers.mjs",
    "props": "node scripts/props.mjs --write",
    "lint:versions": "node scripts/versions.mjs",
    "lint:motion": "node scripts/check-motion.mjs registry site app",
    "versions": "node scripts/versions.mjs --write",
    "check:radius": "node scripts/check-radius.cjs",
    "check:wrap": "node scripts/check-wrap.cjs",
    "lint:dtcg": "node scripts/tokens.mjs",
    "tokens": "node scripts/tokens.mjs --write",
    "test:registry": "bash scripts/registry-e2e.sh",
    "a11y": "node scripts/a11y.cjs",
    "lint:a11y": "node scripts/a11y-check.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "lint:html-size": "node scripts/check-html-size.mjs",
    "lint:thumbs": "node scripts/thumbs.mjs --check && vitest run tests/unit/block-thumbs.test.ts",
    "adoption": "node scripts/adoption.mjs",
    "readme": "WRITE_README=1 vitest run tests/unit/readme.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.9.2",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.24.3",
    "recharts": "^3.11.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0",
    "urdf-loader": "^0.13.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@babel/core": "^7.29.13",
    "@hookform/resolvers": "^7.0.9",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "http-server": "^14.1.1",
    "shadcn": "^4.23.1",
    "storybook": "^10.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  }
}
