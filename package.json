{
  "name": "@syncrobotic/design-system",
  "version": "0.8.0",
  "private": true,
  "description": "The SYNCROBOTIC design language: tokens, React components and blocks, shipped as a shadcn/ui registry for Tailwind CSS v4.",
  "keywords": [
    "design-system",
    "ui-kit",
    "shadcn",
    "shadcn-registry",
    "shadcn-ui",
    "tailwindcss",
    "tailwindcss-v4",
    "react",
    "nextjs",
    "robotics",
    "design-tokens",
    "emergency-stop",
    "dark-mode"
  ],
  "homepage": "https://syncai-lib-designsystem.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syncrobotic/SyncAI-Lib-DesignSystem.git"
  },
  "bugs": {
    "url": "https://github.com/Syncrobotic/SyncAI-Lib-DesignSystem/issues"
  },
  "author": "SYNCROBOTIC",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "shadcn build -o public/r && next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "registry:build": "shadcn build -o public/r",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "test:visual": "playwright test tests/visual.spec.ts",
    "ci": "npm run lint:tokens && npm run lint:registry && npm run lint:motion && npm run lint:versions && npm run lint:dtcg && npm run typecheck && npm test && npm run build && npm run build-storybook",
    "test": "vitest run",
    "lint:registry": "node scripts/check-registry.mjs",
    "lint:versions": "node scripts/versions.mjs",
    "lint:motion": "node scripts/check-motion.mjs registry site app",
    "versions": "node scripts/versions.mjs --write",
    "lint:dtcg": "node scripts/tokens.mjs",
    "tokens": "node scripts/tokens.mjs --write",
    "test:registry": "bash scripts/registry-e2e.sh",
    "test:a11y": "playwright test tests/a11y.spec.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.4",
    "http-server": "^14.1.1",
    "shadcn": "^3.0.0",
    "storybook": "^8.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
