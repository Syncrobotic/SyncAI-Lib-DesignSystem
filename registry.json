    {
      "name": "syncrobotic-theme",
      "type": "registry:style",
      "title": "SYNCROBOTIC theme",
      "description": "Colour, radius, type, height and motion tokens. Replaces the :root, .dark and @theme blocks from shadcn init.",
      "files": [
        {
          "path": "registry/syncrobotic/styles/syncrobotic-theme.css",
          "type": "registry:file",
          "target": "styles/syncrobotic-theme.css"
        }
      ],
      "meta": {
        "version": "0.6.0",
        "changelog": [
          {
            "version": "0.6.0",
            "date": "2026-11-17",
            "note": "Calmer status hues in both modes (all still ≥ 4.5:1 on every surface); colour rule: colour is for what is abnormal. Motion tokens as CSS: appear/disappear, fade-in, sheet-in/out per side, expand/collapse, and the press utility."
          },
          {
            "version": "0.5.0",
            "date": "2026-11-17",
            "note": "First versioned release. Earlier history is in CHANGELOG.md."
          }
        ]
